      propertyPath: m_text
      value: "\u0411\u043E\u0442 \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E
        \u0431\u043E\u044F, \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
        \u043F\u043E \u0431\u043B\u0438\u0436\u0435 \u043A \u0446\u0435\u043B\u0438
        \u0438 \u0431\u044C\u0435\u0442 \u0435\u0435 \u0440\u0430\u0437\u0440\u044F\u0434\u043E\u043C
        \u0432\u044B\u0441\u043E\u043A\u043E\u0432\u043E\u043B\u044C\u0442\u043D\u043E\u0433\u043E
        \u0442\u043E\u043A\u0430. \u041A \u0441\u0447\u0430\u0441\u0442\u044C\u044E
        \u0435\u0433\u043E \u0431\u0430\u0442\u0430\u0440\u0435\u0438 \u043D\u0435
        \u043C\u043E\u0433\u0443\u0442 \u0434\u0435\u0440\u0436\u0430\u0442\u044C
